{
  "name": "@hasna/hook-knowledge-context",
  "version": "0.1.6",
  "description": "Codewith hook that injects deterministic Knowledge context packs into lifecycle events",
  "type": "module",
  "main": "./dist/hook.js",
  "exports": {
    ".": {
      "import": "./dist/hook.js",
      "types": "./dist/hook.d.ts"
    }
  },
  "files": [
    "dist/hook.js",
    "dist/hook.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/hook.ts --outdir ./dist --target bun && tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap false --noEmit false",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codewith",
    "hook",
    "knowledge",
    "context",
    "deterministic",
    "session-start",
    "user-prompt-submit",
    "subagent-start"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasna/hooks.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^20",
    "typescript": "^5.0.0"
  }
}
